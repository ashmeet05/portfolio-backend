# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.

PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/portfolio?retryWrites=true&w=majority

# Long random text used to sign login tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Email address(es) allowed to add/edit/delete portfolio content (comma-separated)
ADMIN_EMAILS=you@example.com

# Website(s) allowed to call this API (comma-separated). Add your live site here.
CORS_ORIGINS=http://localhost:3000

# Optional: DNS servers for mongodb+srv lookups (default 8.8.8.8,1.1.1.1). Use "system" to turn off.
# DNS_SERVERS=8.8.8.8,1.1.1.1
